{
  "name": "recall-code",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Question-centered flashcards for coding interview practice",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run build && node scripts/serve.mjs --dist",
    "dev": "npm start",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/model.test.mjs tests/sync.test.mjs tests/database.test.mjs tests/catalog.test.mjs tests/reminders.test.mjs tests/progress.test.mjs",
    "test:e2e": "playwright test",
    "test:java": "node scripts/verify-java.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "wrangler": "^4.151.2"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "luxon": "^3.7.2"
  }
}
